{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://empty-service-production-731c.up.railway.app/api/$1"
    },
    {
      "src": "/health",
      "dest": "https://empty-service-production-731c.up.railway.app/health"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
